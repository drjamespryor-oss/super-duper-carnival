import React from 'react';
import { AreaChart, Area, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import { CashJumpLabelResolver, TransactionContext } from './CashJumpLabelResolver';

// Extend your data points to hold the transaction context
interface ChartDataPoint {
  date: string;
  cashBalance: number;
  txContext?: TransactionContext;
}

interface CustomTooltipProps {
  active?: boolean;
  payload?: any[];
}

// Custom Tooltip component to inject the precise transaction label
const CashChartTooltip: React.FC<CustomTooltipProps> = ({ active, payload }) => {
  if (active && payload && payload.length) {
    const data: ChartDataPoint = payload[0].payload;
    
    // Resolve label dynamically if a corporate action event exists at this data point
    const label = data.txContext 
      ? CashJumpLabelResolver.getLabel(data.txContext) 
      : 'Balance';

    return (
      <div style={{ backgroundColor: '#fff', padding: '10px', border: '1px solid #ccc' }}>
        <p className="label">{`${data.date}`}</p>
        <p style={{ color: '#8884d8', fontWeight: 'bold' }}>{label}: ${data.cashBalance}</p>
        {data.txContext?.ticker && (
          <small style={{ color: '#999' }}>Asset: {data.txContext.ticker}</small>
        )}
      </div>
    );
  }
  return null;
};

// Main Component
export const CashBalanceChart: React.FC<{ data: ChartDataPoint[] }> = ({ data }) => {
  return (
    <ResponsiveContainer width="100%" height={300}>
      <AreaChart data={data}>
        <XAxis dataKey="date" />
        <YAxis />
        <Tooltip content={<CashChartTooltip />} />
        <Area type="monotone" dataKey="cashBalance" stroke="#8884d8" fill="#8884d8" />
      </AreaChart>
    </ResponsiveContainer>
  );
};
